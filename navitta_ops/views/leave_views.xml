<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_leave_list" model="ir.ui.view">
        <field name="name">navitta.leave.list</field>
        <field name="model">navitta.leave</field>
        <field name="arch" type="xml">
            <list>
                <field name="branch_id"/>
                <field name="employee_id"/>
                <field name="type"/>
                <field name="from_day"/>
                <field name="to_day"/>
                <field name="cover_employee_id"/>
            </list>
        </field>
    </record>
    <record id="view_leave_form" model="ir.ui.view">
        <field name="name">navitta.leave.form</field>
        <field name="model">navitta.leave</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group><field name="employee_id"/><field name="type"/><field name="from_day"/><field name="to_day"/></group>
                        <group><field name="cover_employee_id" domain="[('id', '!=', employee_id)]"
                                      help="زميلتها اللي تغطي الفرع: تتأجل إجازتها الأسبوعية اللي في الفترة، وتحدد الإدارة موعدها البديل."/></group>
                    </group>
                    <field name="deferred_ids" readonly="1">
                        <list><field name="employee_id"/><field name="original_day"/><field name="new_day"/></list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_leave_search" model="ir.ui.view">
        <field name="name">navitta.leave.search</field>
        <field name="model">navitta.leave</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="branch_id"/>
                <filter name="current" string="الحالية والقادمة" domain="[('to_day', '>=', context_today().strftime('%Y-%m-%d'))]"/>
            </search>
        </field>
    </record>
    <record id="action_leaves" model="ir.actions.act_window">
        <field name="name">الإجازات</field>
        <field name="res_model">navitta.leave</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_current': 1}</field>
    </record>

    <record id="view_deferred_list" model="ir.ui.view">
        <field name="name">navitta.deferred.off.list</field>
        <field name="model">navitta.deferred.off</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0" decoration-warning="not new_day">
                <field name="employee_id" readonly="1"/>
                <field name="branch_id"/>
                <field name="original_day" readonly="1"/>
                <field name="new_day"/>
                <field name="leave_id" readonly="1"/>
            </list>
        </field>
    </record>
    <record id="action_deferred" model="ir.actions.act_window">
        <field name="name">أوفات مؤجلة بسبب التغطية</field>
        <field name="res_model">navitta.deferred.off</field>
        <field name="view_mode">list</field>
        <field name="help" type="html"><p>حدد «الموعد الجديد» لكل أوف تأجل، ويوصل الموظفة إيميل بالموعد.</p></field>
    </record>

    <record id="view_leave_request_list" model="ir.ui.view">
        <field name="name">navitta.leave.request.list</field>
        <field name="model">navitta.leave.request</field>
        <field name="arch" type="xml">
            <list create="0" decoration-warning="state == 'pending'" decoration-info="state == 'cover'" decoration-muted="state in ('rejected', 'cover_no')">
                <field name="create_date" string="قُدّم"/>
                <field name="branch_id"/>
                <field name="employee_id"/>
                <field name="type"/>
                <field name="from_day"/>
                <field name="to_day"/>
                <field name="cover_employee_id"/>
                <field name="reason"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_leave_request_form" model="ir.ui.view">
        <field name="name">navitta.leave.request.form</field>
        <field name="model">navitta.leave.request</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_approve" type="object" string="موافقة" class="btn-primary" invisible="state != 'pending'"/>
                    <button name="action_reject" type="object" string="رفض" invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar" statusbar_visible="cover,pending,approved"/>
                </header>
                <sheet>
                    <group>
                        <group><field name="employee_id" readonly="1"/><field name="type" readonly="1"/><field name="from_day" readonly="1"/><field name="to_day" readonly="1"/></group>
                        <group><field name="cover_employee_id" readonly="1"/><field name="cover_note" readonly="1"/><field name="decided_at" readonly="1"/></group>
                    </group>
                    <group><field name="reason" readonly="1"/><field name="note" readonly="state != 'pending'" placeholder="ملاحظة للموظفة (تُرسل مع القرار)"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_leave_request_search" model="ir.ui.view">
        <field name="name">navitta.leave.request.search</field>
        <field name="model">navitta.leave.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <filter name="pending" string="بانتظار موافقتي" domain="[('state', '=', 'pending')]"/>
                <filter name="cover" string="بانتظار الزميلة" domain="[('state', '=', 'cover')]"/>
            </search>
        </field>
    </record>
    <record id="action_leave_requests" model="ir.actions.act_window">
        <field name="name">طلبات الإجازة</field>
        <field name="res_model">navitta.leave.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
