<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- fingerprint terminals -->
    <record id="view_device_list" model="ir.ui.view">
        <field name="name">navitta.device.list</field>
        <field name="model">navitta.device</field>
        <field name="arch" type="xml">
            <list decoration-warning="state == 'pending'" decoration-muted="state == 'blocked'">
                <field name="name"/>
                <field name="serial_number"/>
                <field name="branch_id"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-warning="state == 'pending'"/>
                <field name="online" widget="boolean" string="Online now"/>
                <field name="last_seen"/>
                <field name="unmatched_count"/>
            </list>
        </field>
    </record>

    <record id="view_device_form" model="ir.ui.view">
        <field name="name">navitta.device.form</field>
        <field name="model">navitta.device</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Approve device" class="btn-primary" invisible="state == 'active'"/>
                    <button name="action_block" type="object" string="Block" invisible="state == 'blocked'"
                            confirm="Punches from this device will not be accepted until you approve it again. Continue?"/>
                    <button name="action_reprocess" type="object" string="Reprocess punches without an employee" invisible="not unmatched_count"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,active,blocked"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_punches" type="object" class="oe_stat_button" icon="fa-hand-pointer-o">
                            <field name="punch_count" widget="statinfo" string="Punches"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <div invisible="state != 'pending'" class="alert alert-warning" role="alert">
                        A new device connected to Odoo. Make sure it is your branch's device (the serial number is on the device label), set the branch, then click "Approve device".
                        Until it is approved, the device keeps its punches and sends them afterwards.
                    </div>
                    <group>
                        <group>
                            <field name="serial_number"/>
                            <field name="branch_id" required="state == 'active'"/>
                            <field name="allowed_ip" placeholder="Optional"/>
                        </group>
                        <group>
                            <field name="online" widget="boolean"/>
                            <field name="last_seen"/>
                            <field name="last_ip"/>
                            <field name="unmatched_count"/>
                        </group>
                    </group>
                    <group string="Device info" invisible="not info">
                        <field name="info" nolabel="1" colspan="2"/>
                    </group>
                    <div class="text-muted">
                        <b>Connecting the device:</b> On the device: Menu → "Comm." → "Cloud Server Setting":
                        server address = your Odoo address (e.g. odoo.example.com), port 443 with HTTPS enabled (or 80 / the Odoo port without it).
                        The device appears here after its first connection.
                        <br/><b>Linking employees:</b> each employee's number on the device (User ID) goes on her card, in "Fingerprint device ID".
                        The first punch of the day = check-in; the last punch two or more minutes later = check-out.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_devices" model="ir.actions.act_window">
        <field name="name">Fingerprint devices</field>
        <field name="res_model">navitta.device</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No fingerprint devices yet</p>
            <p>Set the fingerprint device (ZKTeco) to "Cloud Server" with your Odoo address and it appears here automatically, awaiting your approval. Or add it manually by its serial number.</p>
        </field>
    </record>

    <!-- punches as received -->
    <record id="view_device_punch_list" model="ir.ui.view">
        <field name="name">navitta.device.punch.list</field>
        <field name="model">navitta.device.punch</field>
        <field name="arch" type="xml">
            <list create="0" decoration-danger="state in ('unmatched', 'error')" decoration-warning="state == 'tasks'" decoration-muted="state == 'duplicate'">
                <field name="punched_at"/>
                <field name="device_id"/>
                <field name="branch_id"/>
                <field name="device_user_id"/>
                <field name="employee_id"/>
                <field name="verify_label"/>
                <field name="state" widget="badge" decoration-success="state in ('in', 'out')" decoration-warning="state == 'tasks'" decoration-danger="state in ('unmatched', 'error')"/>
                <field name="message"/>
            </list>
        </field>
    </record>
    <record id="view_device_punch_form" model="ir.ui.view">
        <field name="name">navitta.device.punch.form</field>
        <field name="model">navitta.device.punch</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <header>
                    <button name="action_reprocess" type="object" string="Reprocess" invisible="state not in ('unmatched', 'tasks', 'error')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="punched_at"/>
                            <field name="device_id"/>
                            <field name="device_user_id"/>
                            <field name="employee_id"/>
                        </group>
                        <group>
                            <field name="verify_label"/>
                            <field name="status"/>
                            <field name="attendance_id"/>
                            <field name="message"/>
                        </group>
                    </group>
                    <field name="raw"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_device_punch_search" model="ir.ui.view">
        <field name="name">navitta.device.punch.search</field>
        <field name="model">navitta.device.punch</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="device_user_id"/>
                <field name="device_id"/>
                <filter name="problems" string="No employee or error" domain="[('state', 'in', ('unmatched', 'error'))]"/>
                <filter name="f_day" string="Date" date="punched_at"/>
                <group>
                    <filter name="g_device" string="Device" context="{'group_by': 'device_id'}"/>
                    <filter name="g_state" string="Result" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_device_punches" model="ir.actions.act_window">
        <field name="name">Fingerprint device log</field>
        <field name="res_model">navitta.device.punch</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_device_punch_reprocess" model="ir.actions.server">
        <field name="name">Reprocess</field>
        <field name="model_id" ref="model_navitta_device_punch"/>
        <field name="binding_model_id" ref="model_navitta_device_punch"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_reprocess()</field>
    </record>
</odoo>
