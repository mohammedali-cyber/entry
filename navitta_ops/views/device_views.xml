<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- fingerprint terminals -->
    <record id="view_device_list" model="ir.ui.view">
        <field name="name">navitta.device.list</field>
        <field name="model">navitta.device</field>
        <field name="arch" type="xml">
            <list decoration-warning="state == 'pending'" decoration-muted="state == 'blocked'">
                <field name="name"/>
                <field name="serial_number"/>
                <field name="branch_id"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-warning="state == 'pending'"/>
                <field name="online" widget="boolean" string="متصل الحين"/>
                <field name="last_seen"/>
                <field name="unmatched_count"/>
            </list>
        </field>
    </record>

    <record id="view_device_form" model="ir.ui.view">
        <field name="name">navitta.device.form</field>
        <field name="model">navitta.device</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="اعتماد الجهاز" class="btn-primary" invisible="state == 'active'"/>
                    <button name="action_block" type="object" string="إيقاف" invisible="state == 'blocked'"
                            confirm="بصمات هذا الجهاز ما راح تنقبل لين تعتمده مرة ثانية. متابعة؟"/>
                    <button name="action_reprocess" type="object" string="إعادة معالجة البصمات بدون موظفة" invisible="not unmatched_count"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,active,blocked"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_punches" type="object" class="oe_stat_button" icon="fa-hand-pointer-o">
                            <field name="punch_count" widget="statinfo" string="بصمة"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <div invisible="state != 'pending'" class="alert alert-warning" role="alert">
                        جهاز جديد اتصل بـ Odoo. تأكد إنه جهاز فرعك (الرقم التسلسلي على ملصق الجهاز)، حدد الفرع، ثم «اعتماد الجهاز».
                        قبل الاعتماد يحتفظ الجهاز بالبصمات ويرسلها بعده.
                    </div>
                    <group>
                        <group>
                            <field name="serial_number"/>
                            <field name="branch_id" required="state == 'active'"/>
                            <field name="allowed_ip" placeholder="اختياري"/>
                        </group>
                        <group>
                            <field name="online" widget="boolean"/>
                            <field name="last_seen"/>
                            <field name="last_ip"/>
                            <field name="unmatched_count"/>
                        </group>
                    </group>
                    <group string="معلومات الجهاز" invisible="not info">
                        <field name="info" nolabel="1" colspan="2"/>
                    </group>
                    <div class="text-muted">
                        <b>ربط الجهاز:</b> في الجهاز: القائمة ← «الاتصال» ← «إعداد الخادم السحابي»:
                        عنوان الخادم = عنوان Odoo (مثل odoo.example.com)، المنفذ 443 مع تفعيل HTTPS (أو 80 / منفذ Odoo بدونه).
                        بعد أول اتصال يظهر الجهاز هنا.
                        <br/><b>ربط الموظفات:</b> رقم كل موظفة في الجهاز (User ID) يُكتب في بطاقتها: «رقم البصمة في الجهاز».
                        أول بصمة في اليوم = حضور، وآخر بصمة بعدها بدقيقتين أو أكثر = انصراف.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_devices" model="ir.actions.act_window">
        <field name="name">أجهزة البصمة</field>
        <field name="res_model">navitta.device</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">ما فيه أجهزة بصمة بعد</p>
            <p>اضبط جهاز البصمة (ZKTeco) على «الخادم السحابي» بعنوان Odoo، ويظهر هنا تلقائيًا بانتظار اعتمادك. أو أضفه يدويًا برقمه التسلسلي.</p>
        </field>
    </record>

    <!-- punches as received -->
    <record id="view_device_punch_list" model="ir.ui.view">
        <field name="name">navitta.device.punch.list</field>
        <field name="model">navitta.device.punch</field>
        <field name="arch" type="xml">
            <list create="0" decoration-danger="state in ('unmatched', 'error')" decoration-muted="state == 'duplicate'">
                <field name="punched_at"/>
                <field name="device_id"/>
                <field name="branch_id"/>
                <field name="device_user_id"/>
                <field name="employee_id"/>
                <field name="verify_label"/>
                <field name="state" widget="badge" decoration-success="state in ('in', 'out')" decoration-danger="state in ('unmatched', 'error')"/>
                <field name="message"/>
            </list>
        </field>
    </record>
    <record id="view_device_punch_form" model="ir.ui.view">
        <field name="name">navitta.device.punch.form</field>
        <field name="model">navitta.device.punch</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <header>
                    <button name="action_reprocess" type="object" string="إعادة المعالجة" invisible="state not in ('unmatched', 'error')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="punched_at"/>
                            <field name="device_id"/>
                            <field name="device_user_id"/>
                            <field name="employee_id"/>
                        </group>
                        <group>
                            <field name="verify_label"/>
                            <field name="status"/>
                            <field name="attendance_id"/>
                            <field name="message"/>
                        </group>
                    </group>
                    <field name="raw"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_device_punch_search" model="ir.ui.view">
        <field name="name">navitta.device.punch.search</field>
        <field name="model">navitta.device.punch</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="device_user_id"/>
                <field name="device_id"/>
                <filter name="problems" string="بدون موظفة أو خطأ" domain="[('state', 'in', ('unmatched', 'error'))]"/>
                <filter name="f_day" string="التاريخ" date="punched_at"/>
                <group>
                    <filter name="g_device" string="الجهاز" context="{'group_by': 'device_id'}"/>
                    <filter name="g_state" string="النتيجة" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_device_punches" model="ir.actions.act_window">
        <field name="name">سجل جهاز البصمة</field>
        <field name="res_model">navitta.device.punch</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_device_punch_reprocess" model="ir.actions.server">
        <field name="name">إعادة المعالجة</field>
        <field name="model_id" ref="model_navitta_device_punch"/>
        <field name="binding_model_id" ref="model_navitta_device_punch"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_reprocess()</field>
    </record>
</odoo>
