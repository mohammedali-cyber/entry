<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_branch_list" model="ir.ui.view">
        <field name="name">navitta.branch.list</field>
        <field name="model">navitta.branch</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="two_shifts"/>
                <field name="cash_balance"/>
                <field name="month_expenses"/>
                <field name="stock_roll_invoice"/>
                <field name="stock_roll_card"/>
                <field name="stock_bags"/>
            </list>
        </field>
    </record>

    <record id="view_branch_form" model="ir.ui.view">
        <field name="name">navitta.branch.form</field>
        <field name="model">navitta.branch</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title"><h1><field name="name" placeholder="Branch …"/></h1></div>
                    <group>
                        <group string="Branch">
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="two_shifts"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Cash box">
                            <field name="cash_opening_balance"/>
                            <field name="cash_opening_date"/>
                            <field name="cash_balance"/>
                            <field name="month_expenses"/>
                            <field name="pending_expenses"/>
                        </group>
                    </group>
                    <group string="Supplies (current balance)">
                        <field name="stock_roll_invoice"/>
                        <field name="stock_roll_card"/>
                        <field name="stock_bags"/>
                        <div colspan="2" class="text-muted">To change the balance, add an "Adjustment" move from "Supply moves".</div>
                    </group>
                    <notebook>
                        <page string="Employees" name="employees">
                            <field name="employee_ids" context="{'default_branch_id': id}">
                                <list editable="bottom">
                                    <field name="slot" widget="handle"/>
                                    <field name="name"/>
                                    <field name="weekly_off"/>
                                    <field name="shift" readonly="not parent.two_shifts"/>
                                    <field name="device_user_id"/>
                                    <field name="has_pin"/>
                                </list>
                            </field>
                        </page>
                        <page string="Fingerprint devices" name="devices">
                            <field name="device_ids" context="{'default_branch_id': id}">
                                <list><field name="name"/><field name="serial_number"/><field name="state"/><field name="last_seen"/></list>
                            </field>
                        </page>
                        <page string="Device accounts" name="users">
                            <field name="user_ids" readonly="1">
                                <list><field name="name"/><field name="login"/></list>
                            </field>
                            <div class="text-muted">Create a user for each branch device, give it the "Navitta Branches: Branch device" group, and choose the branch in the "Navitta branch" field.</div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_branches" model="ir.actions.act_window">
        <field name="name">Branches</field>
        <field name="res_model">navitta.branch</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
