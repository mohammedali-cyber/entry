<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- delete log (26.3): read-only copy of every record deleted from the management screens -->
    <record id="view_delete_log_list" model="ir.ui.view">
        <field name="name">navitta.delete.log.list</field>
        <field name="model">navitta.delete.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date" string="Time"/>
                <field name="kind"/>
                <field name="summary"/>
                <field name="branch_id"/>
                <field name="reason"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>
    <record id="view_delete_log_form" model="ir.ui.view">
        <field name="name">navitta.delete.log.form</field>
        <field name="model">navitta.delete.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group><field name="kind"/><field name="summary"/><field name="branch_id"/></group>
                        <group><field name="create_date" string="Time"/><field name="user_id"/><field name="res_model"/><field name="res_id"/></group>
                    </group>
                    <group><field name="reason"/></group>
                    <field name="data_text" widget="text" readonly="1" class="font-monospace"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_delete_log_search" model="ir.ui.view">
        <field name="name">navitta.delete.log.search</field>
        <field name="model">navitta.delete.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="summary"/>
                <field name="reason"/>
                <field name="branch_id"/>
                <group><filter name="g_kind" string="Record" context="{'group_by': 'kind'}"/>
                    <filter name="g_user" string="Deleted by" context="{'group_by': 'user_id'}"/></group>
            </search>
        </field>
    </record>
    <record id="action_delete_log" model="ir.actions.act_window">
        <field name="name">Delete log</field>
        <field name="res_model">navitta.delete.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ideas backlog (26.3) -->
    <record id="view_idea_list" model="ir.ui.view">
        <field name="name">navitta.idea.list</field>
        <field name="model">navitta.idea</field>
        <field name="arch" type="xml">
            <list delete="0">
                <field name="title"/>
                <field name="version"/>
                <field name="state"/>
                <field name="create_date" string="Added"/>
                <field name="updated_at"/>
            </list>
        </field>
    </record>
    <record id="view_idea_form" model="ir.ui.view">
        <field name="name">navitta.idea.form</field>
        <field name="model">navitta.idea</field>
        <field name="arch" type="xml">
            <form delete="0">
                <sheet>
                    <group>
                        <group><field name="title"/><field name="version"/><field name="state"/></group>
                        <group><field name="photo" widget="image" options="{'size': [0, 160]}"/></group>
                    </group>
                    <field name="details" placeholder="Details (optional)"/>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
