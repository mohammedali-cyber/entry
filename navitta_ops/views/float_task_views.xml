<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ today's float -->
    <record id="view_float_list" model="ir.ui.view">
        <field name="name">navitta.float.list</field>
        <field name="model">navitta.float</field>
        <field name="arch" type="xml">
            <list create="0" decoration-danger="state == 'short'" decoration-warning="state == 'pending'">
                <field name="day"/>
                <field name="branch_id"/>
                <field name="kind"/>
                <field name="amount" sum="Total"/>
                <field name="expected"/>
                <field name="difference" decoration-danger="difference &lt; 0" decoration-warning="difference &gt; 0"/>
                <field name="counted_by"/>
                <field name="counted_at"/>
                <field name="confirmed_by" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'ok'" decoration-danger="state == 'short'" decoration-warning="state == 'pending'"/>
                <field name="note" optional="show"/>
                <field name="photo_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_float_form" model="ir.ui.view">
        <field name="name">navitta.float.form</field>
        <field name="model">navitta.float</field>
        <field name="arch" type="xml">
            <form create="0">
                <sheet>
                    <group>
                        <group string="Who and when">
                            <field name="branch_id" readonly="1"/>
                            <field name="day" readonly="1"/>
                            <field name="kind" readonly="1"/>
                            <field name="counted_by" readonly="1"/>
                            <field name="counted_at" readonly="1"/>
                            <field name="confirm_needed" readonly="1"/>
                            <field name="confirmed_by" readonly="1"/>
                            <field name="confirmed_at" readonly="1"/>
                            <field name="state"/>
                            <field name="note"/>
                        </group>
                        <group string="Notes and coins">
                            <field name="n200" readonly="1"/>
                            <field name="n100" readonly="1"/>
                            <field name="n50" readonly="1"/>
                            <field name="n20" readonly="1"/>
                            <field name="n10" readonly="1"/>
                            <field name="n5" readonly="1"/>
                            <field name="n2" readonly="1"/>
                            <field name="n1" readonly="1"/>
                            <field name="n050" readonly="1"/>
                            <field name="n025" readonly="1"/>
                            <field name="amount" readonly="1"/>
                            <field name="expected" readonly="1"/>
                            <field name="difference"/>
                            <field name="photo_id" readonly="1"/>
                        </group>
                    </group>
                    <div class="text-muted">The start-of-shift count is made on the counter with a photo of the drawer and confirmed by a colleague; the end-of-shift count is made in the daily report. A total that differs from the branch's float amount needs a note and is emailed to Management.</div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_float_search" model="ir.ui.view">
        <field name="name">navitta.float.search</field>
        <field name="model">navitta.float</field>
        <field name="arch" type="xml">
            <search>
                <field name="branch_id"/>
                <field name="counted_by"/>
                <filter name="short" string="Short" domain="[('state', '=', 'short')]"/>
                <filter name="pending" string="Waiting for confirmation" domain="[('state', '=', 'pending')]"/>
                <separator/>
                <filter name="start" string="Start of shift" domain="[('kind', '=', 'start')]"/>
                <filter name="end" string="End of shift" domain="[('kind', '=', 'end')]"/>
                <separator/>
                <filter name="day" string="Day" date="day"/>
                <group expand="0" string="Group by">
                    <filter name="g_branch" string="Branch" context="{'group_by': 'branch_id'}"/>
                    <filter name="g_day" string="Day" context="{'group_by': 'day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_floats" model="ir.actions.act_window">
        <field name="name">Today's float</field>
        <field name="res_model">navitta.float</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html"><p>The float counted at the start of the shift on the counter (with a photo and a colleague's confirmation) and at the end of the shift in the daily report, note by note.</p></field>
    </record>

    <!-- ============================================================ today's tasks -->
    <record id="view_task_def_list" model="ir.ui.view">
        <field name="name">navitta.task.def.list</field>
        <field name="model">navitta.task.def</field>
        <field name="arch" type="xml">
            <list editable="bottom" delete="0" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="phase"/>
                <field name="title"/>
                <field name="who" readonly="auto"/>
                <field name="photo" readonly="auto"/>
                <field name="auto" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_task_def_search" model="ir.ui.view">
        <field name="name">navitta.task.def.search</field>
        <field name="model">navitta.task.def</field>
        <field name="arch" type="xml">
            <search>
                <field name="title"/>
                <filter name="inactive" string="Deactivated" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group by">
                    <filter name="g_phase" string="Period" context="{'group_by': 'phase'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_task_defs" model="ir.actions.act_window">
        <field name="name">Daily tasks</field>
        <field name="res_model">navitta.task.def</field>
        <field name="view_mode">list</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Add the tasks of the day</p>
            <p>Each period opens at its time (General settings → Daily tasks). “Each her section”: employee 1 the right side and employee 2 the left side; if only one is on shift, both sides are hers. Tasks marked automatically (float, report) mark themselves. Tasks are not deleted: deactivate them instead.</p></field>
    </record>

    <record id="view_task_done_list" model="ir.ui.view">
        <field name="name">navitta.task.done.list</field>
        <field name="model">navitta.task.done</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="day"/>
                <field name="branch_id"/>
                <field name="phase"/>
                <field name="task_id"/>
                <field name="part"/>
                <field name="employee_id"/>
                <field name="done_at"/>
                <field name="photo_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_task_done_search" model="ir.ui.view">
        <field name="name">navitta.task.done.search</field>
        <field name="model">navitta.task.done</field>
        <field name="arch" type="xml">
            <search>
                <field name="branch_id"/>
                <field name="employee_id"/>
                <field name="task_id"/>
                <filter name="day" string="Day" date="day"/>
                <group expand="0" string="Group by">
                    <filter name="g_branch" string="Branch" context="{'group_by': 'branch_id'}"/>
                    <filter name="g_day" string="Day" context="{'group_by': 'day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_task_done" model="ir.actions.act_window">
        <field name="name">Done tasks</field>
        <field name="res_model">navitta.task.done</field>
        <field name="view_mode">list</field>
        <field name="help" type="html"><p>Every task an employee signed with her PIN. Deleting a row re-opens the task.</p></field>
    </record>

    <record id="view_task_alert_list" model="ir.ui.view">
        <field name="name">navitta.task.alert.list</field>
        <field name="model">navitta.task.alert</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-danger="missed">
                <field name="day"/>
                <field name="branch_id"/>
                <field name="phase"/>
                <field name="missed"/>
            </list>
        </field>
    </record>

    <record id="action_task_alerts" model="ir.actions.act_window">
        <field name="name">Missed tasks</field>
        <field name="res_model">navitta.task.alert</field>
        <field name="view_mode">list</field>
        <field name="domain">[('missed', '!=', False)]</field>
        <field name="help" type="html"><p>When a period is over with tasks not done, Management gets one email per branch and period, listed here.</p></field>
    </record>
</odoo>
