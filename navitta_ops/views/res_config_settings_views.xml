<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.navitta</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Navitta Branches" string="Navitta Branches" name="navitta_ops" groups="navitta_ops.group_navitta_admin">
                    <block title="Shift &amp; rules" name="navitta_shift">
                        <setting string="🌙 Evening shift" help="Start and end of the evening shift (every branch), in the branches' local time">
                            <div class="d-flex gap-2 align-items-center">
                                <field name="navitta_shift_start" widget="float_time" class="w-25"/> <span>to</span>
                                <field name="navitta_shift_end" widget="float_time" class="w-25"/>
                            </div>
                            <field name="navitta_tz"/>
                        </setting>
                        <setting string="☀️ Morning shift" help="Only in the branches with a morning shift. Lateness counts from each employee's own shift start; choose her shift in her employee form.">
                            <div class="d-flex gap-2 align-items-center">
                                <field name="navitta_am_start" widget="float_time" class="w-25"/> <span>to</span>
                                <field name="navitta_am_end" widget="float_time" class="w-25"/>
                            </div>
                            <div class="mt-2"><span>Branches with a morning shift:</span>
                                <field name="navitta_two_shift_branch_ids" widget="many2many_tags" options="{'no_create': True}"/></div>
                        </setting>
                        <setting string="Days without a morning shift" help="On these days morning employees work the evening shift">
                            <div class="d-flex flex-wrap gap-3">
                                <span><field name="navitta_no_am_0"/> <label for="navitta_no_am_0"/></span>
                                <span><field name="navitta_no_am_1"/> <label for="navitta_no_am_1"/></span>
                                <span><field name="navitta_no_am_2"/> <label for="navitta_no_am_2"/></span>
                                <span><field name="navitta_no_am_3"/> <label for="navitta_no_am_3"/></span>
                                <span><field name="navitta_no_am_4"/> <label for="navitta_no_am_4"/></span>
                                <span><field name="navitta_no_am_5"/> <label for="navitta_no_am_5"/></span>
                                <span><field name="navitta_no_am_6"/> <label for="navitta_no_am_6"/></span>
                            </div>
                        </setting>
                        <setting string="Check-in grace period" help="After it, lateness counts from the start of the shift">
                            <field name="navitta_grace"/> <span>min</span>
                        </setting>
                        <setting string="Daily break" help="No grace period; exceeding it falls under the lateness rules">
                            <field name="navitta_break_max"/> <span>min</span>
                        </setting>
                        <setting string="Grace chances per month" help="Shared between late check-ins and break overruns">
                            <field name="navitta_chances"/>
                        </setting>
                    </block>
                    <block title="Email &amp; reports" name="navitta_mail">
                        <setting string="Management email" help="Receives the branches summary every night at 11:45 PM, plus request and expense alerts. Sending requires an outgoing mail server in the Odoo settings.">
                            <field name="navitta_report_email" widget="email"/>
                        </setting>
                        <setting string="VAT" help="Used to compute VAT and net in sales reports (sales are recorded including VAT)">
                            <field name="navitta_vat_rate"/> <span>%</span>
                        </setting>
                    </block>
                    <block title="Branch devices" name="navitta_devices">
                        <setting string="Photo with iPad punch" help="When the employee enters her PIN to check in or out, the iPad takes her photo with the front camera, and Management compares it with her reference photo. If the iPad blocks the camera, the punch is still recorded and marked &quot;No photo&quot;.">
                            <field name="navitta_checkin_photo"/>
                        </setting>
                        <setting string="Opening cash count and closing tasks" help="The first employee to check in counts the cash float by denomination before the visit counter opens. Each employee only gets the check-out punch after she closes her visits, the daily report is sent and she counts the closing cash. Any difference in the amount is emailed to Management.">
                            <field name="navitta_cash_tasks"/>
                            <div class="mt-2"><button name="%(navitta_ops.action_cash_counts)d" type="action" string="Cash count log" class="btn-link" icon="fa-money"/></div>
                        </setting>
                        <setting string="Fingerprint devices (ZKTeco)" help="Physical fingerprint devices that send attendance straight to the system over the internet, using the device's &quot;Cloud Server&quot; feature.">
                            <button name="%(navitta_ops.action_devices)d" type="action" string="Fingerprint devices" class="btn-link" icon="fa-hand-pointer-o"/>
                        </setting>
                        <setting string="Management password" help="Required on the branch device to change the target and to cancel a check-out an employee recorded by mistake">
                            <div>
                                <span invisible="not navitta_admin_pw_set" class="badge text-bg-success">🔒 Set</span>
                                <span invisible="navitta_admin_pw_set" class="badge text-bg-warning">Not set yet</span>
                            </div>
                            <button name="action_navitta_admin_password" type="object" string="Set password" class="btn-link" icon="fa-key"/>
                        </setting>
                        <setting string="Minimum supplies" help="Below this number, an alert shows for the branch and Management">
                            <div class="d-flex flex-wrap gap-2">
                                <span>🧾 Receipt roll</span><field name="navitta_min_roll_invoice" class="w-25"/>
                                <span>💳 Card roll</span><field name="navitta_min_roll_card" class="w-25"/>
                                <span>🛍️ Bags</span><field name="navitta_min_bags" class="w-25"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_navitta_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'navitta_ops', 'bin_size': False}</field>
    </record>
</odoo>
