<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_navitta" model="ir.ui.view">
        <field name="name">res.users.form.navitta</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Navitta Branches" name="navitta" groups="navitta_ops.group_navitta_admin">
                    <group>
                        <field name="navitta_branch_id"/>
                        <field name="action_id" string="Home screen" help="For branch devices, choose &quot;Branch screen&quot; so it opens right after login"/>
                    </group>
                    <div class="text-muted">For a branch device account: choose the branch, give it the "Navitta Branches / Branch device" group from the Access Rights tab, and set the "Home Action" to Branch screen.</div>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_branch_users" model="ir.actions.act_window">
        <field name="name">Branch device accounts</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('navitta_branch_id', '!=', False)]</field>
        <field name="context">{'search_default_filter_no_share': 1}</field>
        <!-- the full user form (permissions + Navitta tab), not Odoo's short "simple" user form -->
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('base.view_users_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('base.view_users_form')})]"/>
    </record>
</odoo>
