<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cash_count_list" model="ir.ui.view">
        <field name="name">navitta.cash.count.list</field>
        <field name="model">navitta.cash.count</field>
        <field name="arch" type="xml">
            <list create="0" decoration-danger="has_expected and difference &lt; -0.99" decoration-warning="has_expected and difference &gt; 0.99">
                <field name="day"/>
                <field name="branch_id"/>
                <field name="kind" widget="badge" decoration-info="kind == 'open'" decoration-muted="kind == 'close'"/>
                <field name="employee_id"/>
                <field name="counted_at" optional="hide"/>
                <field name="total" sum="Total"/>
                <field name="has_expected" column_invisible="1"/>
                <field name="expected" invisible="not has_expected"/>
                <field name="difference" invisible="not has_expected"/>
                <field name="note" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_cash_count_form" model="ir.ui.view">
        <field name="name">navitta.cash.count.form</field>
        <field name="model">navitta.cash.count</field>
        <field name="arch" type="xml">
            <form create="0">
                <sheet>
                    <div class="oe_title"><h2><field name="kind" readonly="1"/> – <field name="branch_id" readonly="1"/></h2></div>
                    <group>
                        <group string="Count">
                            <field name="day"/>
                            <field name="employee_id"/>
                            <field name="counted_at"/>
                            <field name="note"/>
                        </group>
                        <group string="Denominations">
                            <field name="n500"/><field name="n200"/><field name="n100"/><field name="n50"/>
                            <field name="n20"/><field name="n10"/><field name="n5"/><field name="n1"/><field name="coins"/>
                        </group>
                    </group>
                    <group>
                        <group string="Result">
                            <field name="total"/>
                            <field name="has_expected"/>
                            <field name="expected" invisible="not has_expected"/>
                            <field name="difference" invisible="not has_expected"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        <b>Opening:</b> Compared with the branch's last closing count.
                        <b>Closing:</b> Compared with the opening cash float + today's cash sales − bank deposit.
                        A positive difference is a surplus, a negative one a shortage.
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_cash_count_search" model="ir.ui.view">
        <field name="name">navitta.cash.count.search</field>
        <field name="model">navitta.cash.count</field>
        <field name="arch" type="xml">
            <search>
                <field name="branch_id"/>
                <field name="employee_id"/>
                <filter name="diff" string="With difference" domain="[('has_expected', '=', True), '|', ('difference', '&gt;=', 1), ('difference', '&lt;=', -1)]"/>
                <separator/>
                <filter name="open" string="Opening cash float" domain="[('kind', '=', 'open')]"/>
                <filter name="close" string="Closing cash count" domain="[('kind', '=', 'close')]"/>
                <filter name="f_day" string="Day" date="day"/>
                <group>
                    <filter name="g_branch" string="Branch" context="{'group_by': 'branch_id'}"/>
                    <filter name="g_day" string="Day" context="{'group_by': 'day:day'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_cash_counts" model="ir.actions.act_window">
        <field name="name">Opening cash count</field>
        <field name="res_model">navitta.cash.count</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html"><p>Here you see the opening cash float counted by the first employee and the closing cash count each employee makes before checking out, by denomination.</p></field>
    </record>
</odoo>
