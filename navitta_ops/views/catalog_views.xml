<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_catalog_list" model="ir.ui.view">
        <field name="name">navitta.catalog.item.list</field>
        <field name="model">navitta.catalog.item</field>
        <field name="arch" type="xml">
            <list>
                <field name="item_no"/>
                <field name="model"/>
                <field name="color"/>
                <field name="size"/>
                <field name="price"/>
                <field name="alu"/>
                <field name="dcs" optional="show"/>
                <field name="heel" optional="hide"/>
                <field name="material" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_catalog_search" model="ir.ui.view">
        <field name="name">navitta.catalog.item.search</field>
        <field name="model">navitta.catalog.item</field>
        <field name="arch" type="xml">
            <search>
                <field name="item_no"/>
                <field name="model"/>
                <field name="alu"/>
                <field name="color"/>
                <group><filter name="g_item" string="Model" context="{'group_by': 'item_no'}"/></group>
            </search>
        </field>
    </record>
    <record id="action_catalog" model="ir.actions.act_window">
        <field name="name">Models file</field>
        <field name="res_model">navitta.catalog.item</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html"><p>Upload the models Excel file from "Upload models file". Each upload fully replaces the old file.</p></field>
    </record>
</odoo>
