<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_thread_list" model="ir.ui.view">
        <field name="name">navitta.thread.list</field>
        <field name="model">navitta.thread</field>
        <field name="arch" type="xml">
            <list create="0" decoration-bf="unread">
                <field name="last_at"/>
                <field name="branch_id"/>
                <field name="employee_id"/>
                <field name="topic"/>
                <field name="state"/>
                <field name="unread"/>
            </list>
        </field>
    </record>
    <record id="view_thread_form" model="ir.ui.view">
        <field name="name">navitta.thread.form</field>
        <field name="model">navitta.thread</field>
        <field name="arch" type="xml">
            <form create="0">
                <sheet>
                    <group><field name="employee_id" readonly="1"/><field name="topic" readonly="1"/><field name="state"/></group>
                    <field name="message_ids" readonly="1">
                        <list><field name="create_date" string="Time"/><field name="sender"/><field name="body"/></list>
                    </field>
                    <div class="text-muted">To reply to the employee, use the "Dashboard" (she receives the reply by email).</div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_threads" model="ir.actions.act_window">
        <field name="name">Employee messages</field>
        <field name="res_model">navitta.thread</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
