<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_list" model="ir.ui.view">
        <field name="name">navitta.employee.list</field>
        <field name="model">navitta.employee</field>
        <field name="arch" type="xml">
            <list>
                <field name="branch_id"/>
                <field name="slot" widget="handle"/>
                <field name="name"/>
                <field name="device_user_id" optional="show"/>
                <field name="email"/>
                <field name="weekly_off"/>
                <field name="has_pin" widget="boolean"/>
                <button name="action_new_pin" type="object" string="New PIN" icon="fa-key"
                        confirm="The current PIN will be cancelled and a new PIN will be created and shown only once. Continue?"/>
            </list>
        </field>
    </record>

    <record id="view_employee_form" model="ir.ui.view">
        <field name="name">navitta.employee.form</field>
        <field name="model">navitta.employee</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_new_pin" type="object" string="Generate new PIN" class="btn-primary"
                            confirm="The current PIN will be cancelled and a new PIN will be created and shown only once. Continue?"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_attendance" type="object" class="oe_stat_button" icon="fa-clock-o" string="Check-ins"/>
                        <button name="action_sales" type="object" class="oe_stat_button" icon="fa-shopping-bag" string="Sales"/>
                        <button name="action_cash_counts" type="object" class="oe_stat_button" icon="fa-money" string="Opening cash count"/>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="photo" widget="image" class="oe_avatar" options="{'preview_image': 'photo'}"/>
                    <div class="oe_title"><h1><field name="name" placeholder="Employee name"/></h1></div>
                    <group>
                        <group string="Branch">
                            <field name="branch_id"/>
                            <field name="slot" string="Order on screen"/>
                            <field name="weekly_off"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Punch">
                            <field name="has_pin"/>
                            <field name="device_user_id" placeholder="e.g. 5"/>
                            <field name="email" widget="email"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        <b>iPad punch:</b> a 4-digit PIN (stored encrypted and cannot be shown; "Generate new PIN" gives a new one), plus a photo from the iPad camera if enabled in the settings.
                        <br/><b>Fingerprint device (ZKTeco):</b> enroll the employee on the device with a number and enter the same number in "Fingerprint device ID". Her earlier unlinked punches are counted automatically after saving.
                        <br/><b>Reference photo:</b> a clear photo of her face to compare punch photos with. You can use a check-in photo from "Attendance".
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_employee_search" model="ir.ui.view">
        <field name="name">navitta.employee.search</field>
        <field name="model">navitta.employee</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="branch_id"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group><filter name="g_branch" string="Branch" context="{'group_by': 'branch_id'}"/></group>
            </search>
        </field>
    </record>

    <record id="action_employees" model="ir.actions.act_window">
        <field name="name">Employees</field>
        <field name="res_model">navitta.employee</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_notification_list" model="ir.ui.view">
        <field name="name">navitta.notification.list</field>
        <field name="model">navitta.notification</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" decoration-danger="state in ('exception', 'no_email')" decoration-muted="state == 'sent'">
                <field name="create_date" string="Time"/>
                <field name="employee_id"/>
                <field name="to_email"/>
                <field name="subject"/>
                <field name="state"/>
                <field name="failure_reason" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_notification_form" model="ir.ui.view">
        <field name="name">navitta.notification.form</field>
        <field name="model">navitta.notification</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group><field name="create_date" string="Time"/><field name="employee_id"/><field name="to_email"/><field name="state"/><field name="failure_reason"/></group>
                    <h3><field name="subject"/></h3>
                    <field name="body"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_notifications" model="ir.actions.act_window">
        <field name="name">Email notifications</field>
        <field name="res_model">navitta.notification</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
