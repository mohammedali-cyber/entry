<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_navitta" model="ir.module.category">
        <field name="name">فروع نافيتا</field>
        <field name="sequence">60</field>
    </record>

    <record id="group_navitta_branch" model="res.groups">
        <field name="name">جهاز فرع</field>
        <field name="category_id" ref="module_category_navitta"/>
        <field name="comment">حساب جهاز الفرع (الآيباد): يرى بيانات فرعه فقط، وكل تعديل يمر عبر شاشة الفرع.</field>
    </record>

    <record id="group_navitta_admin" model="res.groups">
        <field name="name">إدارة الفروع</field>
        <field name="category_id" ref="module_category_navitta"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">الإدارة: كل الفروع والقرارات والإعدادات.</field>
    </record>

    <!-- branch devices: only their own branch -->
