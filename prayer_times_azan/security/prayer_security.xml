<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_prayer_times" model="ir.module.category">
        <field name="name">Prayer Times</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_prayer_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_prayer_times"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Manage prayer locations, calculation settings and azan sounds.</field>
    </record>

    <record id="prayer_location_company_rule" model="ir.rule">
        <field name="name">Prayer location: multi-company</field>
        <field name="model_id" ref="model_prayer_location"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="prayer_timetable_company_rule" model="ir.rule">
        <field name="name">Prayer timetable: multi-company</field>
        <field name="model_id" ref="model_prayer_timetable"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
