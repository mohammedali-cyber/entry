<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="prayer_times_azan.PrayerTimesSystray">
        <div class="o_prayer_systray" t-if="state.loaded">
            <Dropdown position="'bottom-end'" menuClass="'o_prayer_systray_dropdown p-0'">
                <button class="o_prayer_systray_toggle d-flex align-items-center gap-1"
                        t-att-class="{'o_prayer_playing': prayer.isPlaying}"
                        title="Prayer Times">
                    <svg class="o_prayer_systray_icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 2.2c.3 0 .5.2.5.5v1.1c2.9.6 5 3.1 5 6V11h1V8.5c0-.6.4-1 1-1s1 .4 1 1V11h.5c.3 0 .5.2.5.5V21H2v-9.5c0-.3.2-.5.5-.5H3V8.5c0-.6.4-1 1-1s1 .4 1 1V11h1.5V9.8c0-2.9 2.1-5.4 5-6V2.7c0-.3.2-.5.5-.5zM12 14c-1.1 0-2 .9-2 2v4h4v-4c0-1.1-.9-2-2-2z"/>
                    </svg>
                    <span t-if="next" class="d-none d-md-inline small">
                        <t t-esc="next.name"/> <t t-esc="prayer.formatTime(next)"/>
                    </span>
                </button>
                <t t-set-slot="content">
                    <div class="o_prayer_panel">
                        <div class="o_prayer_panel_header px-3 py-2 border-bottom">
                            <t t-if="state.location">
                                <div class="fw-bold">
                                    <i class="fa fa-map-marker me-1"/>
                                    <t t-esc="state.location.name"/>
                                </div>
                                <div t-if="next" class="small text-muted">
                                    <t t-esc="next.name"/> · <span class="o_prayer_countdown" t-esc="countdown"/>
                                </div>
                            </t>
                            <div t-else="" class="text-muted small">
                                No prayer location is configured.
                            </div>
                        </div>
                        <table t-if="state.location" class="table table-sm mb-0 o_prayer_table">
                            <tbody>
                                <tr t-foreach="prayer.todayPrayers" t-as="p" t-key="p.key"
                                    t-att-class="{'o_prayer_next': isNext(p), 'o_prayer_past': isPast(p)}">
                                    <td class="ps-3">
                                        <i t-if="p.azan" class="fa fa-bell-o me-1 text-muted" title="Azan"/>
                                        <i t-else="" class="fa fa-fw me-1"/>
                                        <t t-esc="p.name"/>
                                    </td>
                                    <td class="pe-3 text-end font-monospace" t-esc="prayer.formatTime(p)"/>
                                </tr>
                            </tbody>
                        </table>
                        <div class="d-flex flex-wrap gap-2 px-3 py-2 border-top">
                            <button t-if="prayer.isPlaying" class="btn btn-sm btn-danger"
                                    t-on-click="() => prayer.stop()">
                                <i class="fa fa-stop me-1"/>Stop azan
                            </button>
                            <button t-if="state.location" class="btn btn-sm btn-secondary"
                                    t-on-click="onTogglePlayAzan">
                                <t t-if="state.playAzan"><i class="fa fa-volume-up me-1"/>Sound on</t>
                                <t t-else=""><i class="fa fa-volume-off me-1"/>Sound off</t>
                            </button>
                            <button t-if="state.location and !prayer.isPlaying" class="btn btn-sm btn-secondary"
                                    t-on-click="() => prayer.testAzan()">
                                <i class="fa fa-play me-1"/>Test azan
                            </button>
                            <button t-if="ui.permission === 'default'" class="btn btn-sm btn-link"
                                    t-on-click="onEnableDesktop">
                                <i class="fa fa-desktop me-1"/>Enable desktop notifications
                            </button>
                        </div>
                    </div>
                </t>
            </Dropdown>
        </div>
    </t>

    <t t-name="prayer_times_azan.PrayerAzanPlayer">
        <audio t-if="url" controls="controls" preload="none" class="w-100" t-att-src="url"/>
        <span t-else="" class="text-muted">Save the record to listen to the file.</span>
    </t>

</templates>
