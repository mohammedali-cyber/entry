<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_users_view_form_preferences_prayer" model="ir.ui.view">
        <field name="name">res.users.preferences.form.prayer</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences_page']" position="after">
                <page string="Prayer Times" name="prayer_times">
                    <group>
                        <group>
                            <field name="prayer_location_id" readonly="0" options="{'no_create': True}"
                                   placeholder="Company default"/>
                            <field name="prayer_notify" readonly="0"/>
                            <field name="prayer_play_azan" readonly="0"/>
                        </group>
                        <group>
                            <field name="prayer_reminder_minutes" readonly="0"/>
                            <field name="prayer_azan_volume" readonly="0" invisible="not prayer_play_azan"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="res_users_view_form_prayer" model="ir.ui.view">
        <field name="name">res.users.form.prayer</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']" position="after">
                <page string="Prayer Times" name="prayer_times" invisible="share">
                    <group>
                        <group>
                            <field name="prayer_location_id" options="{'no_create': True}"
                                   placeholder="Company default"/>
                            <field name="prayer_notify"/>
                            <field name="prayer_play_azan"/>
                        </group>
                        <group>
                            <field name="prayer_reminder_minutes"/>
                            <field name="prayer_azan_volume" invisible="not prayer_play_azan"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
