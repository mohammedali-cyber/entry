<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="product_lost_finder.DetailReport">
        <div class="o_action o_lost_sale_detail h-100 overflow-auto">
            <div class="o_lsd_container">
                <h2 class="o_lsd_title">Detailed Report</h2>

                <div class="o_lsd_filters">
                    <div class="o_lsd_filter">
                        <label for="o_lsd_product">Product</label>
                        <div class="o_lsd_product">
                            <AutoComplete id="'o_lsd_product'"
                                value="''"
                                resetOnSelect="true"
                                sources="productSources"
                                onSelect.bind="onProductSelect"
                                placeholder.translate="Add a product..."
                                class="'o_lsd_product_input'"/>
                        </div>
                    </div>
                    <t t-foreach="state.options.attributes" t-as="attribute" t-key="attribute.id">
                        <div class="o_lsd_filter">
                            <label t-att-for="'o_lsd_attr_' + attribute.id" t-esc="attribute.name"/>
                            <select t-att-id="'o_lsd_attr_' + attribute.id" class="form-select form-select-sm"
                                t-on-change="(ev) => this.onValueChange(attribute, ev)">
                                <option value="0" t-att-selected="!state.valueByAttribute[attribute.id]">All</option>
                                <t t-foreach="attribute.values" t-as="value" t-key="value.id">
                                    <option t-att-value="value.id" t-att-selected="state.valueByAttribute[attribute.id] === value.id"
                                        t-esc="value.name"/>
                                </t>
                            </select>
                        </div>
                    </t>
                    <div class="o_lsd_filter">
                        <label for="o_lsd_branch">Branch</label>
                        <select t-if="state.options.is_manager" id="o_lsd_branch" class="form-select form-select-sm"
                            t-model.number="state.warehouseId" t-on-change="loadReport">
                            <option value="0">All branches</option>
                            <t t-foreach="state.options.warehouses" t-as="warehouse" t-key="warehouse.id">
                                <option t-att-value="warehouse.id" t-esc="warehouse.name"/>
                            </t>
                        </select>
                        <div t-else="" id="o_lsd_branch" class="form-control form-control-sm bg-light" t-esc="branchLabel"/>
                    </div>
                    <div class="o_lsd_filter">
                        <label for="o_lsd_period">Period</label>
                        <select id="o_lsd_period" class="form-select form-select-sm"
                            t-model="state.period" t-on-change="loadReport">
                            <t t-foreach="periods" t-as="period" t-key="period.key">
                                <option t-att-value="period.key" t-esc="period.label"/>
                            </t>
                        </select>
                    </div>
                    <div class="o_lsd_filter">
                        <label for="o_lsd_status">Status</label>
                        <select id="o_lsd_status" class="form-select form-select-sm"
                            t-model="state.status" t-on-change="loadReport">
                            <option value="all">All products</option>
                            <option value="lost">Lost only</option>
                            <option value="available">Available only</option>
                        </select>
                    </div>
                    <t t-if="state.period === 'custom'">
                        <div class="o_lsd_filter">
                            <label for="o_lsd_from">From</label>
                            <input id="o_lsd_from" type="date" class="form-control form-control-sm"
                                t-model="state.dateFrom" t-on-change="loadReport"/>
                        </div>
                        <div class="o_lsd_filter">
                            <label for="o_lsd_to">To</label>
                            <input id="o_lsd_to" type="date" class="form-control form-control-sm"
                                t-model="state.dateTo" t-on-change="loadReport"/>
                        </div>
                    </t>
                </div>

                <div t-if="state.productFilters.length" class="o_lsd_chips">
                    <span class="text-muted small">Products:</span>
                    <t t-foreach="state.productFilters" t-as="filter" t-key="filter.key">
                        <span class="badge rounded-pill text-bg-light o_lsd_chip">
                            <t t-esc="filter.label"/>
                            <button type="button" class="btn btn-link p-0 ms-1 o_lsd_chip_remove" title="Remove"
                                aria-label="Remove" t-on-click="() => this.removeProductFilter(filter)">
                                <i class="fa fa-times"/>
                            </button>
                        </span>
                    </t>
                    <button type="button" class="btn btn-link btn-sm p-0" t-on-click="clearProducts">Clear all</button>
                </div>

                <div class="o_lsd_toolbar">
                    <div t-if="state.options.attributes.length" class="d-flex align-items-center gap-2">
                        <label for="o_lsd_columns" class="text-muted text-nowrap">Columns:</label>
                        <select id="o_lsd_columns" class="form-select form-select-sm"
                            t-model.number="state.columnAttributeId" t-on-change="loadReport">
                            <t t-foreach="state.options.attributes" t-as="attribute" t-key="attribute.id">
                                <option t-att-value="attribute.id" t-esc="attribute.name"/>
                            </t>
                        </select>
                    </div>
                    <button type="button" class="btn btn-light btn-sm" t-on-click="resetFilters">
                        <i class="fa fa-undo me-1" aria-hidden="true"/>Reset filters
                    </button>
                    <i t-if="state.loading" class="fa fa-circle-o-notch fa-spin text-muted"/>
                    <button type="button" class="btn btn-success btn-sm ms-auto"
                        t-att-disabled="!state.report or !state.report.rows.length" t-on-click="exportExcel">
                        <i class="fa fa-file-excel-o me-1" aria-hidden="true"/>Export to Excel
                    </button>
                </div>

                <t t-set="report" t-value="state.report"/>
                <div class="o_lsd_legend text-muted small">
                    <span><span class="o_lsd_dot o_lsd_dot_ok"/>In stock now</span>
                    <span><span class="o_lsd_dot o_lsd_dot_lost"/>Lost (no stock)</span>
                    <span><span class="o_lsd_requested">Requested 3</span> = lost sales recorded in the period</span>
                </div>
                <div t-if="report and !report.rows.length" class="alert alert-secondary text-center">
                    No product matches these filters.
                </div>
                <div t-elif="report" class="table-responsive o_lsd_table_wrap">
                    <div class="text-muted small mb-2" t-esc="rowsHint"/>
                    <table class="table table-sm table-bordered align-middle mb-0 o_lsd_table">
                        <thead>
                            <tr>
                                <th class="o_lsd_label">Product</th>
                                <t t-foreach="report.columns" t-as="column" t-key="column.key">
                                    <th t-esc="column.name"/>
                                </t>
                                <th>Stock</th>
                                <th>Requested</th>
                                <th>Lost Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="report.rows" t-as="row" t-key="row_index">
                                <tr>
                                    <td class="o_lsd_label" t-esc="row.label"/>
                                    <t t-foreach="report.columns" t-as="column" t-key="column.key">
                                        <t t-set="cell" t-value="row.cells[column.key]"/>
                                        <td t-if="!cell" class="o_lsd_empty">—</td>
                                        <td t-else="" t-att-class="cell.is_lost ? 'o_lsd_cell_lost' : 'o_lsd_cell_ok'">
                                            <bdi dir="ltr" class="o_lsd_stock" t-esc="formatStock(cell.stock)"/>
                                            <span t-if="cell.lost" class="o_lsd_requested">
                                                Requested <bdi dir="ltr" t-esc="formatStock(cell.lost)"/>
                                            </span>
                                        </td>
                                    </t>
                                    <td class="fw-bold"><bdi dir="ltr" t-esc="formatStock(row.stock)"/></td>
                                    <td t-att-class="row.lost ? 'o_lsd_qty' : 'o_lsd_empty'"><bdi dir="ltr" t-esc="formatQty(row.lost)"/></td>
                                    <td class="text-nowrap" t-esc="row.amount ? formatAmount(row.amount) : '—'"/>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td class="o_lsd_label">Total</td>
                                <t t-foreach="report.columns" t-as="column" t-key="column.key">
                                    <t t-set="totals" t-value="report.column_totals[column.key]"/>
                                    <td>
                                        <bdi dir="ltr" t-esc="formatStock(totals ? totals.stock : 0)"/>
                                        <span t-if="totals and totals.lost" class="o_lsd_requested">
                                            Requested <bdi dir="ltr" t-esc="formatStock(totals.lost)"/>
                                        </span>
                                    </td>
                                </t>
                                <td><bdi dir="ltr" t-esc="formatStock(report.stock)"/></td>
                                <td><bdi dir="ltr" t-esc="formatQty(report.lost)"/></td>
                                <td class="text-nowrap" t-esc="formatAmount(report.amount)"/>
                            </tr>
                        </tfoot>
                    </table>
                    <div t-if="hasMoreRows" class="text-center my-3">
                        <button type="button" class="btn btn-secondary" t-att-disabled="state.loadingMore" t-on-click="loadMore">
                            <i t-if="state.loadingMore" class="fa fa-circle-o-notch fa-spin me-1"/>
                            Show more
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
