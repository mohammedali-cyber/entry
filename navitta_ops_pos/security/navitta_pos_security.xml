<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A branch device must not read the other branches' staff in Odoo's own Employees app: it sees its branch's cashier
         accounts (of its employees and of its points of sale's cashier lists) and its own employee only. -->
    <record id="rule_branch_hr_employee" model="ir.rule">
        <field name="name">Navitta: own branch Odoo employees</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="domain_force">['|', ('id', 'in', user.navitta_hr_employee_ids.ids), ('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('navitta_ops.group_navitta_branch'))]"/>
    </record>
    <record id="rule_branch_hr_employee_public" model="ir.rule">
        <field name="name">Navitta: own branch Odoo employees (public)</field>
        <field name="model_id" ref="hr.model_hr_employee_public"/>
        <field name="domain_force">['|', ('id', 'in', user.navitta_hr_employee_ids.ids), ('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('navitta_ops.group_navitta_branch'))]"/>
    </record>
    <!-- management keeps everything (also an account that is in both groups) -->
    <record id="rule_admin_hr_employee" model="ir.rule">
        <field name="name">Navitta admin: all Odoo employees</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('navitta_ops.group_navitta_admin'))]"/>
    </record>
    <record id="rule_admin_hr_employee_public" model="ir.rule">
        <field name="name">Navitta admin: all Odoo employees (public)</field>
        <field name="model_id" ref="hr.model_hr_employee_public"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('navitta_ops.group_navitta_admin'))]"/>
    </record>
    <!-- the branch device restriction never blocks a system administrator (Settings), even one given the device group
         by mistake: the rules of different groups are combined with OR -->
    <record id="rule_system_hr_employee" model="ir.rule">
        <field name="name">Navitta: system administrators see all Odoo employees</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
    <record id="rule_system_hr_employee_public" model="ir.rule">
        <field name="name">Navitta: system administrators see all Odoo employees (public)</field>
        <field name="model_id" ref="hr.model_hr_employee_public"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
