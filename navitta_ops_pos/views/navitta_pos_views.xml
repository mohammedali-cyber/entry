<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- branch: its points of sale and buttons -->
    <record id="view_branch_form_pos" model="ir.ui.view">
        <field name="name">navitta.branch.form.pos</field>
        <field name="model">navitta.branch</field>
        <field name="inherit_id" ref="navitta_ops.view_branch_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='devices']" position="before">
                <page string="Point of Sale" name="pos">
                    <div class="d-flex gap-2 mb-2">
                        <button name="action_link_cashiers" type="object" string="Link employees to cashier accounts" class="btn-primary"
                                help="For each employee without a cashier account: links her to the Odoo employee with the same name (or creates one) and updates the cashier list of the branch's points of sale"/>
                        <button name="action_pos_sync_month" type="object" string="Sync sales (last 60 days)" class="btn-secondary"/>
                    </div>
                    <field name="pos_config_ids" context="{'default_navitta_branch_id': id}">
                        <list create="0" editable="bottom"><field name="name" readonly="1"/><field name="navitta_branch_id" column_invisible="1"/>
                            <field name="navitta_employee_id" string="Owner employee"/><field name="navitta_session_label"/></list>
                    </field>
                    <group><field name="pos_last_sync"/></group>
                    <div class="text-muted">
                        The branch's sales, VAT, cash and each employee's sales are computed from the (paid) orders of these points of sale, every 10 minutes and when a session is closed.
                        To link a point of sale: open it from "Point of Sale → Configuration → Point of Sales" and choose the "Navitta branch".
                        Each employee's sales are counted by the cashier account she sold with (Change Cashier); sales without a cashier show as "Shared account".
                        A point of sale with an "Owner employee" is her own device: every sale on it counts for her whoever is picked as cashier, and she is its only cashier.
                    </div>
                </page>
            </xpath>
            <xpath expr="//field[@name='employee_ids']/list/field[@name='device_user_id']" position="after">
                <field name="hr_employee_id" string="Cashier account"/>
            </xpath>
        </field>
    </record>

    <!-- employee: her cashier -->
    <record id="view_employee_form_pos" model="ir.ui.view">
        <field name="name">navitta.employee.form.pos</field>
        <field name="model">navitta.employee</field>
        <field name="inherit_id" ref="navitta_ops.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='device_user_id']" position="after">
                <field name="hr_employee_id"/>
            </xpath>
        </field>
    </record>
    <record id="view_employee_list_pos" model="ir.ui.view">
        <field name="name">navitta.employee.list.pos</field>
        <field name="model">navitta.employee</field>
        <field name="inherit_id" ref="navitta_ops.view_employee_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='device_user_id']" position="after">
                <field name="hr_employee_id" optional="show" string="Cashier account"/>
            </xpath>
        </field>
    </record>

    <!-- point of sale: its branch -->
    <record id="view_pos_config_form_navitta" model="ir.ui.view">
        <field name="name">pos.config.form.navitta</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='title']" position="after">
                <group><field name="navitta_branch_id"/><field name="navitta_employee_id" invisible="not navitta_branch_id"/></group>
            </xpath>
        </field>
    </record>
    <record id="view_pos_session_form_navitta" model="ir.ui.view">
        <field name="name">pos.session.form.navitta</field>
        <field name="model">pos.session</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_session_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='start_at']" position="before">
                <field name="navitta_opened_by_id"/>
            </xpath>
        </field>
    </record>
</odoo>
