<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- branch: its points of sale (devices) and the owner of each -->
    <record id="view_branch_form_pos" model="ir.ui.view">
        <field name="name">navitta.branch.form.pos</field>
        <field name="model">navitta.branch</field>
        <field name="inherit_id" ref="navitta_ops.view_branch_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='devices']" position="before">
                <page string="Point of Sale" name="pos">
                    <div class="d-flex gap-2 mb-2">
                        <button name="action_pos_sync_all" type="object" string="Sync all sales from the Point of Sale" class="btn-primary"
                                help="Counts every day of this branch again from its Point of Sale orders (the whole history)"/>
                    </div>
                    <field name="pos_config_ids" context="{'default_navitta_branch_id': id}">
                        <list create="0" editable="bottom"><field name="name" string="Device (point of sale)" readonly="1"/>
                            <field name="navitta_branch_id" column_invisible="1"/>
                            <field name="navitta_employee_id" string="Owner employee" options="{'no_create': True}"/>
                            <field name="navitta_session_label"/></list>
                    </field>
                    <group><field name="pos_last_sync"/></group>
                    <div class="text-muted">
                        The branch's sales, VAT, cash and each employee's sales are computed from the (paid) orders of these points of sale: every 10 minutes, when a session is closed, and for any period opened in the management screens (the whole history).
                        To link a point of sale: Point of Sale → Configuration → Settings, choose the point of sale, then its “Navitta branch” and its “Owner employee”.
                        A point of sale with an “Owner employee” is her own device: every sale on it counts for her, whoever is picked as cashier.
                        On a point of sale without an owner, each sale counts for the employee whose cashier account was picked (“Her Point of Sale cashier account”, optional), else as “Shared account”.
                        The Point of Sale itself is not changed: its cashier list and settings stay as you configure them.
                    </div>
                </page>
            </xpath>
            <xpath expr="//field[@name='employee_ids']/list/field[@name='device_user_id']" position="after">
                <field name="hr_employee_id" string="Cashier account (optional)" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <!-- employee: her own device, and her cashier account (optional, existing Odoo employees only) -->
    <record id="view_employee_form_pos" model="ir.ui.view">
        <field name="name">navitta.employee.form.pos</field>
        <field name="model">navitta.employee</field>
        <field name="inherit_id" ref="navitta_ops.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='device_user_id']" position="after">
                <field name="pos_config_owned_ids" widget="many2many_tags" readonly="1" string="Her own device (point of sale)"
                       invisible="not pos_config_owned_ids"/>
                <field name="hr_employee_id" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
    <record id="view_employee_list_pos" model="ir.ui.view">
        <field name="name">navitta.employee.list.pos</field>
        <field name="model">navitta.employee</field>
        <field name="inherit_id" ref="navitta_ops.view_employee_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='device_user_id']" position="after">
                <field name="hr_employee_id" optional="show" string="Cashier account" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <!-- point of sale: its branch and its owner -->
    <record id="view_pos_config_form_navitta" model="ir.ui.view">
        <field name="name">pos.config.form.navitta</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='title']" position="after">
                <group string="Navitta" name="navitta">
                    <field name="navitta_branch_id" options="{'no_create': True}"/>
                    <field name="navitta_employee_id" invisible="not navitta_branch_id" options="{'no_create': True}"
                           placeholder="None: each sale counts for the cashier picked"/>
                </group>
            </xpath>
        </field>
    </record>
    <record id="view_pos_settings_navitta" model="ir.ui.view">
        <field name="name">res.config.settings.pos.navitta</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='restaurant_section']" position="before">
                <block title="Navitta" id="navitta_pos_section">
                    <setting string="Navitta branch" help="This point of sale's sales count for this Navitta branch">
                        <field name="pos_navitta_branch_id" options="{'no_create': True}"/>
                    </setting>
                    <setting string="Owner employee (her own device)" invisible="not pos_navitta_branch_id"
                             help="Every sale on this point of sale counts for this employee, whoever is picked as cashier. Leave empty for a shared device">
                        <field name="pos_navitta_employee_id" options="{'no_create': True}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
    <record id="view_pos_session_form_navitta" model="ir.ui.view">
        <field name="name">pos.session.form.navitta</field>
        <field name="model">pos.session</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_session_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='start_at']" position="before">
                <field name="navitta_opened_by_id"/>
            </xpath>
        </field>
    </record>
</odoo>
